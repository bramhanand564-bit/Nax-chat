{
  "expo": {
    "name": "Nax Chat",
    "slug": "nax-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nax.chat"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nax Chat to access your camera for video calls and photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nax Chat to access your gallery to share photos."
        }
      ]
    ]
  }
}
